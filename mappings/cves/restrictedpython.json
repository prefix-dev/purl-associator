    {
      "schema_version": "1.7.3",
      "id": "GHSA-wqc8-x2pr-7jqh",
      "published": "2023-07-10T21:53:22Z",
      "modified": "2024-02-16T08:18:40.438142Z",
      "aliases": [
        "CVE-2023-37271",
        "PYSEC-2023-118"
