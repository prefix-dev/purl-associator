    {
      "schema_version": "1.7.3",
      "id": "GHSA-xjw2-6jm9-rf67",
      "published": "2023-08-30T20:47:58Z",
      "modified": "2024-02-16T08:18:58.766349Z",
      "aliases": [
        "CVE-2023-41039",
        "PYSEC-2023-159"
